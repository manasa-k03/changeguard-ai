# ChangeGuard AI Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server
PORT=5000
NODE_ENV=development

# JWT Secret - use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# JWT expiry
JWT_EXPIRES_IN=7d

# OpenAI API Key - get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Frontend URL (for CORS)
# Local dev:  FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://your-app-name.vercel.app
FRONTEND_URL=http://localhost:5173

# Database path (relative to backend root)
DB_PATH=./data/changeguard.db
